# 預設離線示範，不需要金鑰，也不會呼叫模型。
# 修改後重啟助理；Docker 使用 docker compose up -d --force-recreate。
# 完整範例：docs/model-services.md；欄位說明：docs/configuration.md。
LLM_MODE=mock

# openai 代表相容協定，Ollama 也使用此模式。以下三欄在相容模式必填。
# BASE_URL 不含 /chat/completions；網址、金鑰與模型不會送到瀏覽器。
# 下方網址只是占位值，不會自動啟動 LiteLLM。
# LiteLLM 官方範例用 http://localhost:4000；是否包含 /v1 依實際路由確認。
# Ollama 本機使用 http://localhost:11434/v1，請依選定服務更換下方網址。
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=
LLM_MODEL=

# 留白使用內建繁體中文提示詞；自訂值不會讓模型自動讀取網站資料。
SYSTEM_PROMPT=

# 本機直接使用時留白；HTTPS 代理部署時填助理公開來源，例如：
# https://assistant.school.example（不要填主網站或模型網址）。
PUBLIC_BASE_URL=

# JSON 清單，保留中括號與雙引號。第一欄是可嵌入助理的主網站來源。
ALLOWED_FRAME_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
TRUSTED_PROXY_IPS=[]

MAX_CONCURRENT_REQUESTS=4
REQUESTS_PER_MINUTE=20
REQUEST_TIMEOUT_SECONDS=90
BODY_READ_TIMEOUT_SECONDS=10
MAX_BODY_BYTES=65536
MAX_MESSAGES=20
MAX_MESSAGE_CHARS=4000
MAX_TOTAL_CHARS=24000

# The checked-in default is a deterministic, visible demo. It does not call a model.
LLM_MODE=mock

# Required when LLM_MODE=openai. The service calls an OpenAI-compatible
# /chat/completions endpoint; these values are never sent to the browser.
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=
LLM_MODEL=

# Optional. Leave blank to use the application's Chinese school-assistant prompt.
SYSTEM_PROMPT=

# Leave blank for direct local use. Set the exact public HTTPS origin when a
# reverse proxy terminates TLS, for example https://assistant.school.example.
PUBLIC_BASE_URL=

# JSON arrays, including the brackets and double quotes.
ALLOWED_FRAME_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
TRUSTED_PROXY_IPS=[]

MAX_CONCURRENT_REQUESTS=4
REQUESTS_PER_MINUTE=20
REQUEST_TIMEOUT_SECONDS=90
BODY_READ_TIMEOUT_SECONDS=10
MAX_BODY_BYTES=65536
MAX_MESSAGES=20
MAX_MESSAGE_CHARS=4000
MAX_TOTAL_CHARS=24000
